#!/bin/bash
# Template. scripts/run-phase12-aws.sh substitutes @BUCKET@ and @RUN@ and passes
# the result as EC2 user data.
#
# Phase 27 on one GPU worker: the off-the-shelf embedding, Phase 26 reproduced, the training pairs,
# the fine-tuned embedding and the Phase 27 analysis; uploads and stops. 3-hour power-off.
set -u
LOG=/var/log/noema-p12.log
exec > >(tee -a "$LOG") 2>&1
BKT="@BUCKET@"
RNAME="@RUN@"
echo "boot $(date -u +%FT%TZ)"

/usr/sbin/shutdown -h +180
cat > /etc/systemd/system/noema-expiry.service <<'SVC'
[Unit]
Description=Terminate temporary Noema phase 12 worker
[Service]
Type=oneshot
ExecStart=/usr/sbin/poweroff
SVC
cat > /etc/systemd/system/noema-expiry.timer <<'TMR'
[Unit]
Description=Expire temporary phase 12 worker
[Timer]
OnBootSec=175min
Unit=noema-expiry.service
[Install]
WantedBy=timers.target
TMR
systemctl daemon-reload
systemctl enable --now noema-expiry.timer

# Idle watchdog: if the log has not grown for 30 minutes, stop the job so the
# EXIT trap uploads what exists and powers off; power off outright 10 minutes
# later if that did not happen.
cat > /usr/local/bin/noema-watchdog <<'WD'
#!/bin/bash
LOG=/var/log/noema-p12.log
while sleep 300; do
  if [ -z "$(find "$LOG" -mmin -30)" ]; then
    echo "WATCHDOG: log idle 30 min, stopping $(date -u +%FT%TZ)" >> "$LOG"
    pkill -f "(embed|run)-phase26.py|(train|run)-phase27.py"
    sleep 600
    /usr/sbin/poweroff
  fi
done
WD
chmod +x /usr/local/bin/noema-watchdog
systemd-run --unit=noema-watchdog /usr/local/bin/noema-watchdog

finish() {
  rc=$?
  set +e
  echo "FINISH rc=$rc $(date -u +%FT%TZ)"
  cp "$LOG" /opt/noema/out/worker.log 2>/dev/null
  ( cd /opt/noema/out && find . -type f -exec sha256sum {} + > /tmp/SHA256SUMS \
    && mv /tmp/SHA256SUMS SHA256SUMS )
  tar czf /tmp/result.tar.gz -C /opt noema/out
  for i in 1 2 3 4 5; do
    /opt/nvenv/bin/aws s3 cp /tmp/result.tar.gz \
      "s3://$BKT/results/$RNAME/result.tar.gz" --region us-east-2 && break || sleep 20
  done
  /usr/sbin/shutdown -h now
  exit $rc
}
trap finish EXIT
set -e

mkdir -p /opt/noema /opt/noema/out
export DEBIAN_FRONTEND=noninteractive
for i in $(seq 1 12); do apt-get update -qq && break || sleep 30; done
for i in 1 2 3; do apt-get install -y -qq python3-venv curl && break || sleep 60; done
python3 -m venv /opt/nvenv
/opt/nvenv/bin/pip -q install awscli numpy==2.4.4 scipy scikit-learn torch sentence-transformers==6.1.0 transformers==5.17.0 datasets==5.0.1 accelerate
echo "pydeps-done $(date -u +%FT%TZ)"

/opt/nvenv/bin/aws s3 cp "s3://$BKT/$RNAME-task.tar.gz" /tmp/task.tar.gz --region us-east-2
tar xzf /tmp/task.tar.gz -C /opt
cd /opt/noema
export HOME=/root
mkdir -p out/smoke && cp in/papers.jsonl.gz in/refs.jsonl.gz out/ && cp in/papers.jsonl.gz in/refs.jsonl.gz out/smoke/
nvidia-smi --query-gpu=name,memory.total --format=csv || true
EMB="/opt/nvenv/bin/python scripts/embed-phase26.py"
P26="/opt/nvenv/bin/python scripts/run-phase26.py"
P27="/opt/nvenv/bin/python scripts/run-phase27.py"
TRAIN="/opt/nvenv/bin/python scripts/train-phase27.py"
echo "STAGE smoke $(date -u +%FT%TZ)"
$EMB --out out/smoke --smoke
$P27 pairs --out out/smoke --smoke
$TRAIN --out out/smoke --smoke
$P27 analyze --out out/smoke --smoke
rm -rf out/smoke/*.jsonl.gz out/smoke/*.npy out/smoke/st-train
echo "SMOKE PASSED $(date -u +%FT%TZ)"
echo "STAGE embed $(date -u +%FT%TZ)"
$EMB --out out
echo "STAGE phase26 $(date -u +%FT%TZ)"
$P26 --out out --no-lookup
echo "STAGE pairs $(date -u +%FT%TZ)"
$P27 pairs --out out
echo "STAGE train $(date -u +%FT%TZ)"
$TRAIN --out out
echo "STAGE phase27 $(date -u +%FT%TZ)"
$P27 analyze --out out
rm -rf out/*.jsonl.gz out/*.npy out/st-train
echo "JOB DONE $(date -u +%FT%TZ)"
