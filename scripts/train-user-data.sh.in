#!/bin/bash
# Template. scripts/run-train-aws.sh substitutes @BUCKET@ and @RUN@ and passes
# the result as EC2 user data.
#
# Trains phase 4's two encoders with scripts/train-encoders-gpu.py on one GPU,
# embeds the union, uploads everything and stops. The script refuses to run if
# the inputs differ from their frozen manifest.
set -u
LOG=/var/log/noema-train.log
exec > >(tee -a "$LOG") 2>&1
BKT="@BUCKET@"
RNAME="@RUN@"
echo "boot $(date -u +%FT%TZ)"

/usr/sbin/shutdown -h +@MINUTES@
cat > /etc/systemd/system/noema-expiry.service <<'SVC'
[Unit]
Description=Terminate temporary Noema training worker
[Service]
Type=oneshot
ExecStart=/usr/sbin/poweroff
SVC
cat > /etc/systemd/system/noema-expiry.timer <<'TMR'
[Unit]
Description=Expire temporary training worker
[Timer]
OnBootSec=@TIMER@min
Unit=noema-expiry.service
[Install]
WantedBy=timers.target
TMR
systemctl daemon-reload
systemctl enable --now noema-expiry.timer

finish() {
  rc=$?
  set +e
  echo "FINISH rc=$rc $(date -u +%FT%TZ)"
  cp "$LOG" /opt/noema/out/worker.log 2>/dev/null
  ( cd /opt/noema/out && find . -type f -exec sha256sum {} + > /tmp/SHA256SUMS \
    && mv /tmp/SHA256SUMS SHA256SUMS )
  tar czf /tmp/result.tar.gz -C /opt noema/out
  for i in 1 2 3 4 5; do
    /opt/nvenv/bin/aws s3 cp /tmp/result.tar.gz \
      "s3://$BKT/results/$RNAME/result.tar.gz" --region us-east-2 && break || sleep 20
  done
  /usr/sbin/shutdown -h now
  exit $rc
}
trap finish EXIT
set -e

mkdir -p /opt/noema /opt/noema/out
export DEBIAN_FRONTEND=noninteractive
for i in $(seq 1 12); do apt-get update -qq && break || sleep 30; done
for i in 1 2 3; do apt-get install -y -qq python3-venv curl && break || sleep 60; done
python3 -m venv /opt/nvenv
/opt/nvenv/bin/pip -q install awscli numpy==2.4.4 tokenizers==0.22.2 torch==2.11.0
echo "pydeps-done $(date -u +%FT%TZ)"

/opt/nvenv/bin/aws s3 cp "s3://$BKT/$RNAME-task.tar.gz" /tmp/task.tar.gz --region us-east-2
tar xzf /tmp/task.tar.gz -C /opt
nvidia-smi --query-gpu=name,memory.total --format=csv,noheader
/opt/nvenv/bin/python -c "import torch; assert torch.cuda.is_available(), 'no CUDA'; print('cuda', torch.version.cuda)"

BDIR=/opt/noema/out
if [ -f /opt/noema/b/b-model.pt ]; then
  BDIR=/opt/noema/b  # Phase 29: B was trained in phase 28
else
  echo "STAGE train $(date -u +%FT%TZ)"
  /opt/nvenv/bin/python /opt/noema/scripts/train-encoders-gpu.py \
    --inputs /opt/noema/in --out /opt/noema/out
fi

# Phase 29: one line per arm in arms.txt -- name, pairs file, held-out file,
# seed. Only the union's texts, the first in the list, are encoded.
if [ -f /opt/noema/pairs/arms.txt ]; then
  n=$(/opt/nvenv/bin/python -c "import json; print(json.load(open('/opt/noema/pairs/pairs-manifest.json'))['union_texts'])")
  while read -r arm pf hf seed; do
    [ -n "$arm" ] || continue
    echo "STAGE arm $arm $(date -u +%FT%TZ)"
    /opt/nvenv/bin/python /opt/noema/scripts/train-phase28.py --inputs /opt/noema/in \
      --b-dir "$BDIR" --pairs /opt/noema/pairs --arm "$arm" --pairs-file "$pf" \
      --heldout-file "$hf" --seed "$seed" --embed-first "$n" --out "/opt/noema/arms/$arm" \
      </dev/null
    tar czf "/tmp/$arm.tar.gz" -C /opt/noema/arms "$arm"
    /opt/nvenv/bin/aws s3 cp "/tmp/$arm.tar.gz" "s3://$BKT/results/$RNAME/arms/$arm.tar.gz" \
      --region us-east-2 </dev/null
    rm -f "/tmp/$arm.tar.gz"
  done < /opt/noema/pairs/arms.txt
# Phase 28: one fine-tune per arm from this B, the primary arm first. Each arm
# is uploaded as soon as it is done, so a lost worker loses at most one arm.
elif [ -d /opt/noema/pairs ]; then
  ( cd /opt/noema/out && tar czf /tmp/b.tar.gz b-model.pt b-tokenizer.json training-report.json )
  /opt/nvenv/bin/aws s3 cp /tmp/b.tar.gz "s3://$BKT/results/$RNAME/b.tar.gz" --region us-east-2
  for arm in c16-natural c4-natural c8-natural c32-natural c64-natural c128-natural              c200-natural c8-equal c16-equal c32-equal c64-equal c128-equal c200-equal; do
    echo "STAGE arm $arm $(date -u +%FT%TZ)"
    /opt/nvenv/bin/python /opt/noema/scripts/train-phase28.py --inputs /opt/noema/in       --b-dir /opt/noema/out --pairs /opt/noema/pairs --arm "$arm" --out "/opt/noema/arms/$arm"
    tar czf "/tmp/$arm.tar.gz" -C /opt/noema/arms "$arm"
    /opt/nvenv/bin/aws s3 cp "/tmp/$arm.tar.gz" "s3://$BKT/results/$RNAME/arms/$arm.tar.gz"       --region us-east-2
    rm -f "/tmp/$arm.tar.gz"
  done
fi
echo "JOB DONE $(date -u +%FT%TZ)"
